{
  "name": "joplin-plugin-fsrs-review-calendar",
  "version": "2.2.0",
  "description": "An interactive FSRS-powered review calendar for Joplin desktop and mobile.",
  "engines": {
    "node": ">=20.9.0"
  },
  "main": "dist/index.js",
  "scripts": {
    "assets": "node scripts/generate-assets.cjs",
    "build": "webpack --env joplin-plugin-config=buildMain && webpack --env joplin-plugin-config=buildWebview",
    "dist": "npm run build && webpack --env joplin-plugin-config=createArchive",
    "test:smoke": "node tests/plugin-smoke.cjs desktop && node tests/plugin-smoke.cjs mobile && node tests/webview-dom-smoke.cjs && node tests/release-package-smoke.cjs",
    "check": "npm run typecheck && npm run dist && npm run test:smoke",
    "prepare": "npm run check",
    "prepublishOnly": "npm run check",
    "typecheck": "tsc --noEmit",
    "updateVersion": "webpack --env joplin-plugin-config=updateVersion"
  },
  "keywords": [
    "joplin-plugin",
    "fsrs",
    "spaced-repetition",
    "calendar"
  ],
  "author": "TacoHubble",
  "homepage": "https://github.com/TacoHubble/joplin-plugin-fsrs-review-calendar#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TacoHubble/joplin-plugin-fsrs-review-calendar.git"
  },
  "bugs": {
    "url": "https://github.com/TacoHubble/joplin-plugin-fsrs-review-calendar/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/multimonth": "^6.1.21",
    "@fullcalendar/rrule": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "chrono-node": "^2.10.1",
    "rrule": "^2.8.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "chalk": "^4.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "fs-extra": "^11.3.0",
    "glob": "^13.0.6",
    "tar": "^7.5.22",
    "ts-loader": "^9.5.2",
    "typescript": "^5.9.0",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1"
  },
  "files": [
    "publish"
  ]
}
